# Database API Configuration
DATABASE_API_URL=http://localhost:8080/api
# Bot JWT from the backend's generate-bot-token profile; must carry ROLE_BOT. Sent as a Bearer token.
DATABASE_API_KEY=your_api_key_here

# Anthropic API key (used by the /mock command to generate mock request data)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
